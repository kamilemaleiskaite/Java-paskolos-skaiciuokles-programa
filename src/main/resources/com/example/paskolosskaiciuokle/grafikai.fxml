            <NumberAxis label="Mėnesiai" fx:id="xAxis" />
        </xAxis>
        <yAxis>
            <NumberAxis fx:id="yAxis" label="Įmokos suma" />
        </yAxis>
    </LineChart>

</AnchorPane>
